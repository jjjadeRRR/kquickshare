[Desktop Entry]
Type=Service
MimeType=application/octet-stream;
Actions=sendToPhone;
X-KDE-Priority=TopLevel
X-KDE-Protocols=file

[Desktop Action sendToPhone]
Name=Send to phone with KQuickShare…
Name[ru]=Отправить на телефон через KQuickShare…
Icon=org.kde.kquickshare
Exec=kquickshare --send -- %F
